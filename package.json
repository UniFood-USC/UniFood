{
  "name": "unifood",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.0",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "firebase-tools": "^15.32.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:integration": "npm run build:service && BREVO_API_KEY= firebase emulators:exec --project demo-unifood --only auth,firestore,functions 'tsx --test --test-concurrency=1 tests/integration/*.test.ts'",
    "build:service": "tsc -p functions/tsconfig.json",
    "emulators": "npm run build:service && exec firebase emulators:start --project demo-unifood --only auth,firestore,functions",
    "seed": "tsx scripts/seed.ts"
  },
  "private": true
}
