{
  "name": "unifood",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "firebase-tools": "^15.32.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:integration": "npm run build:service && firebase emulators:exec --project demo-unifood --only auth,firestore,functions 'tsx --test --test-concurrency=1 tests/integration/*.test.ts'",
    "build:service": "tsc -p functions/tsconfig.json",
    "emulators": "npm run build:service && firebase emulators:start --project demo-unifood --only auth,firestore,functions",
    "seed": "tsx scripts/seed.ts"
  },
  "private": true
}
